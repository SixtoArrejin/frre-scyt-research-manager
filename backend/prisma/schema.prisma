generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model categorias {
  idCategoria  Int       @id
  equiparacion Boolean?
  tipo         String?   @db.VarChar(20)
  categoria    String?   @db.VarChar(10)
  fecha        DateTime? @db.Date
  normativa    String?   @db.VarChar(20)
  dni          Int
  persona      persona   @relation(fields: [dni], references: [dni], onDelete: NoAction, onUpdate: NoAction, map: "categorias_ibfk_1")

  @@index([dni], map: "dni")
}

model grupoinvestigacion {
  siglas        String    @id @db.VarChar(15)
  nombre        String?   @db.VarChar(40)
  resolucion    String?   @db.VarChar(10)
  fechaCreacion DateTime? @db.Date
  persona       persona[]
  tiene         tiene[]
}

model participa {
  dni        Int
  idProyecto Int
  rol        String    @db.VarChar(50)
  persona    persona   @relation(fields: [dni], references: [dni], onDelete: NoAction, onUpdate: NoAction, map: "participa_ibfk_1")
  proyectos  proyectos @relation(fields: [idProyecto], references: [idProyecto], onDelete: NoAction, onUpdate: NoAction, map: "participa_ibfk_2")

  @@id([dni, idProyecto])
  @@index([idProyecto], map: "idProyecto")
}

model persona {
  dni                                        Int                @id
  nombre                                     String?            @db.VarChar(30)
  apellido                                   String?            @db.VarChar(30)
  activo                                     Boolean?
  comision                                   String?            @db.VarChar(50)
  siglas                                     String             @db.VarChar(15)
  categorias                                 categorias[]
  participa                                  participa[]
  grupoinvestigacion                         grupoinvestigacion @relation(fields: [siglas], references: [siglas], onDelete: NoAction, onUpdate: NoAction, map: "persona_ibfk_1")
  proyectos_proyectos_dniDirectorTopersona   proyectos[]        @relation("proyectos_dniDirectorTopersona")
  proyectos_proyectos_dniCodirectorTopersona proyectos[]        @relation("proyectos_dniCodirectorTopersona")

  @@index([siglas], map: "siglas")
}

model pid {
  idProyectoPid Int       @id
  tipoProyecto  String?   @db.VarChar(100)
  prorrogado    Boolean?
  codPid        String?   @db.VarChar(20)
  programa      String?   @db.VarChar(100)
  disposicion   String?   @db.VarChar(10)
  proyectos     proyectos @relation(fields: [idProyectoPid], references: [idProyecto], onDelete: NoAction, onUpdate: NoAction, map: "pid_ibfk_1")
}

model proyectos {
  idProyecto                               Int                @id
  tipoActividad                            String?            @db.VarChar(50)
  fechaInicio                              DateTime?          @db.Date
  fechaFin                                 DateTime?          @db.Date
  denominacion                             String?            @db.VarChar(250)
  completo                                 Boolean?
  regional                                 String?            @db.VarChar(100)
  convocatoria                             Int?
  estado                                   String?            @db.VarChar(20)
  dniDirector                              Int
  dniCodirector                            Int?
  participa                                participa[]
  pid                                      pid?
  persona_proyectos_dniDirectorTopersona   persona            @relation("proyectos_dniDirectorTopersona", fields: [dniDirector], references: [dni], onDelete: NoAction, onUpdate: NoAction, map: "proyectos_ibfk_1")
  persona_proyectos_dniCodirectorTopersona persona?           @relation("proyectos_dniCodirectorTopersona", fields: [dniCodirector], references: [dni], onDelete: NoAction, onUpdate: NoAction, map: "proyectos_ibfk_2")
  proyectosexternos                        proyectosexternos?
  tiene                                    tiene[]

  @@index([dniCodirector], map: "dniCodirector")
  @@index([dniDirector], map: "dniDirector")
}

model proyectosconfinanciamiento {
  idProyectoFinanciamieno   Int               @id
  montoANR                  Float?            @db.Float
  presentacion              DateTime?         @db.Date
  canon                     Float?            @db.Float
  fechaInicioFinanciamiento DateTime?         @db.Date
  fechaFinFinanciamiento    DateTime?         @db.Date
  linea                     String?           @db.VarChar(30)
  adjudicacion              Int?
  desembolso                Int?
  proyectosexternos         proyectosexternos @relation(fields: [idProyectoFinanciamieno], references: [idProyectoExterno], onDelete: NoAction, onUpdate: NoAction, map: "proyectosconfinanciamiento_ibfk_1")
}

model proyectosexternos {
  idProyectoExterno          Int                         @id
  empresaInstitucion         String?                     @db.VarChar(50)
  anioLinea                  DateTime?                   @db.Date
  tipoConvenio               String?                     @db.VarChar(50)
  proyectosconfinanciamiento proyectosconfinanciamiento?
  proyectos                  proyectos                   @relation(fields: [idProyectoExterno], references: [idProyecto], onDelete: NoAction, onUpdate: NoAction, map: "proyectosexternos_ibfk_1")
}

model tiene {
  siglas             String             @db.VarChar(15)
  idProyecto         Int
  proyectos          proyectos          @relation(fields: [idProyecto], references: [idProyecto], onDelete: NoAction, onUpdate: NoAction, map: "tiene_ibfk_1")
  grupoinvestigacion grupoinvestigacion @relation(fields: [siglas], references: [siglas], onDelete: NoAction, onUpdate: NoAction, map: "tiene_ibfk_2")

  @@id([siglas, idProyecto])
  @@index([idProyecto], map: "idProyecto")
}
