generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model categorias {
  idCategoria  Int       @id @default(autoincrement())
  equiparacion Boolean?
  tipo         String?   @db.VarChar(20)
  categoria    String?   @db.VarChar(10)
  fecha        DateTime? @db.Date
  normativa    String?   @db.VarChar(20)
  idPersona    Int
  comision     String?   @db.VarChar(50)
  personas     personas  @relation(fields: [idPersona], references: [idPersona], onDelete: NoAction, onUpdate: NoAction, map: "categorias_ibfk_1")

  @@index([idPersona], map: "idPersona")
}

model gruposinvestigacion {
  idGrupoInvestigacion Int        @id @default(autoincrement())
  siglas               String?    @unique(map: "siglas") @db.VarChar(15)
  nombre               String?    @db.VarChar(40)
  resolucion           String?    @db.VarChar(10)
  fechaCreacion        DateTime?  @db.Date
  personas             personas[]
  tiene                tiene[]
}

model participa {
  idPersona   Int
  idProyecto  Int
  rol         String    @db.VarChar(50)
  fechaInicio DateTime? @db.Date
  personas    personas  @relation(fields: [idPersona], references: [idPersona], onDelete: NoAction, onUpdate: NoAction, map: "participa_ibfk_1")
  proyectos   proyectos @relation(fields: [idProyecto], references: [idProyecto], onDelete: NoAction, onUpdate: NoAction, map: "participa_ibfk_2")

  @@id([idPersona, idProyecto])
  @@index([idProyecto], map: "idProyecto")
}

model personas {
  idPersona                                  Int                 @id @default(autoincrement())
  dni                                        Int?                @unique(map: "dni")
  nombre                                     String?             @db.VarChar(30)
  apellido                                   String?             @db.VarChar(30)
  fechaIngreso                               DateTime?           @db.Date
  activo                                     Boolean?
  idGrupoInvestigacion                       Int
  categorias                                 categorias[]
  participa                                  participa[]
  gruposinvestigacion                        gruposinvestigacion @relation(fields: [idGrupoInvestigacion], references: [idGrupoInvestigacion], onDelete: NoAction, onUpdate: NoAction, map: "personas_ibfk_1")
  proyectos_proyectos_idDirectorTopersonas   proyectos[]         @relation("proyectos_idDirectorTopersonas")
  proyectos_proyectos_idCodirectorTopersonas proyectos[]         @relation("proyectos_idCodirectorTopersonas")

  @@index([idGrupoInvestigacion], map: "idGrupoInvestigacion")
}

model pids {
  idProyectoPid Int       @id
  tipoProyecto  String?   @db.VarChar(256)
  prorrogado    Boolean?
  codPid        String?   @db.VarChar(256)
  programa      String?   @db.VarChar(256)
  disposicion   String?   @db.VarChar(256)
  proyectos     proyectos @relation(fields: [idProyectoPid], references: [idProyecto], onDelete: NoAction, onUpdate: NoAction, map: "pids_ibfk_1")
}

model proyectos {
  idProyecto                                Int                @id @default(autoincrement())
  tipoActividad                             String?            @db.VarChar(256)
  fechaInicio                               DateTime?          @db.Date
  fechaFin                                  DateTime?          @db.Date
  denominacion                              String?            @db.VarChar(256)
  completo                                  Boolean?
  regional                                  String?            @db.VarChar(256)
  convocatoria                              Int?
  estado                                    String?            @db.VarChar(256)
  idDirector                                Int
  idCodirector                              Int?
  participa                                 participa[]
  pids                                      pids?
  personas_proyectos_idDirectorTopersonas   personas           @relation("proyectos_idDirectorTopersonas", fields: [idDirector], references: [idPersona], onDelete: NoAction, onUpdate: NoAction, map: "proyectos_ibfk_1")
  personas_proyectos_idCodirectorTopersonas personas?          @relation("proyectos_idCodirectorTopersonas", fields: [idCodirector], references: [idPersona], onDelete: NoAction, onUpdate: NoAction, map: "proyectos_ibfk_2")
  proyectosexternos                         proyectosexternos?
  tiene                                     tiene[]

  @@index([idCodirector], map: "idCodirector")
  @@index([idDirector], map: "idDirector")
}

model proyectosconfinanciamiento {
  idProyectoFinanciamieno   Int               @id
  montoANR                  Float?            @db.Float
  presentacion              DateTime?         @db.Date
  canon                     Float?            @db.Float
  fechaInicioFinanciamiento DateTime?         @db.Date
  fechaFinFinanciamiento    DateTime?         @db.Date
  linea                     String?           @db.VarChar(30)
  adjudicacion              Int?
  desembolso                Int?
  proyectosexternos         proyectosexternos @relation(fields: [idProyectoFinanciamieno], references: [idProyectoExterno], onDelete: NoAction, onUpdate: NoAction, map: "proyectosconfinanciamiento_ibfk_1")
}

model proyectosexternos {
  idProyectoExterno          Int                         @id
  empresaInstitucion         String?                     @db.VarChar(50)
  anioLinea                  DateTime?                   @db.Date
  tipoConvenio               String?                     @db.VarChar(50)
  proyectosconfinanciamiento proyectosconfinanciamiento?
  proyectos                  proyectos                   @relation(fields: [idProyectoExterno], references: [idProyecto], onDelete: NoAction, onUpdate: NoAction, map: "proyectosexternos_ibfk_1")
}

model tiene {
  idGrupoInvestigacion Int
  idProyecto           Int
  proyectos            proyectos           @relation(fields: [idProyecto], references: [idProyecto], onDelete: NoAction, onUpdate: NoAction, map: "tiene_ibfk_1")
  gruposinvestigacion  gruposinvestigacion @relation(fields: [idGrupoInvestigacion], references: [idGrupoInvestigacion], onDelete: NoAction, onUpdate: NoAction, map: "tiene_ibfk_2")

  @@id([idGrupoInvestigacion, idProyecto])
  @@index([idProyecto], map: "idProyecto")
}

model usuarios {
  usuario    String  @id @db.VarChar(20)
  contrasena String? @db.VarChar(255)
}

model regionales {
  nombre String @id @db.VarChar(100)
}
