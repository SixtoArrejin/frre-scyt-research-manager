# Puerto en el que se ejecutará el servidor backend (API)
PORT=8000

# URL de conexión para la base de datos PostgreSQL (requerido por Prisma)
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_DB?schema=public
DATABASE_URL="postgresql://postgres:contraseña@localhost:5432/dbscyt?schema=public"

# Clave secreta utilizada para firmar y verificar tokens JWT
# Se recomienda usar una cadena larga y aleatoria en producción
JWT_SECRET="una_clave_secreta_segura_para_jwt"
